# tet-web behind Caddy at https://@SITE@ only.
# Caddy obtains the certificate of the name by itself (ACME, Let's Encrypt)
# and renews it in time, and sends http://@SITE@ to https: by plain HTTP
# nothing is served but that redirect. Installed by web/freebsd/install.sh
# with SITE=@SITE@ once the name points to this machine.

@SITE@ {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8080
}

# Whatever else arrives by plain HTTP, as for the bare address, is sent to
# the name as well.
:80 {
	redir https://@SITE@{uri} permanent
}
